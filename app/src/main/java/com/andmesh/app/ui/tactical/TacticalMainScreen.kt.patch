                    Text(
                        node.statusLabel.uppercase(),
                        color = TacticalColors.Tan,
                        fontFamily = CondensedFontFamily,
                        fontSize = 11.sp
                    )
                }
            }
            Text(
                node.hopsLabel.uppercase(),
                color = TacticalColors.Amber,
                fontFamily = CondensedFontFamily,
                fontSize = 11.sp
            )
        }
        HorizontalDivider(color = TacticalColors.Divider)
    }
}
